. capture program drop buildehdf

. program define buildehdf
  1.     args mode
  2.     use "$DERIVED/master_local_fish_max.dta", clear
  3.     keep if div_fished_s!=. & mu_reg!=.
  4.     if "`mode'" == "177" {
  5.         * restrict to the complete cases BEFORE normalizing
.         foreach v in mu_return sigma_reg_exp avg_pop avg_wage_pc div_emp_diff
> _s ///
>                      div_fished_s broader_permit_share avg_fish_ratio_im {
  6.             quietly drop if missing(`v')
  7.         }
  8.     }
  9.     quietly count
 10.     di as text "   normalization sample: " r(N) " rows"
 11.     foreach var in mu_return sigma_reg_exp div_emp div_emp_diff_s div_emp_
> diff ///
>                      avg_pop broader_emp_share broader_permit_share ///
>                      div_fished_s div_fished ///
>                      avg_fish_ratio_im avg_fish_ratio avg_fish_ratio_im_fc //
> /
>                      avg_wage_pc avg_fishermen {
 12.         gen log_`var' = log(`var')
 13.         quietly summarize log_`var'
 14.         scalar gmean = exp(r(mean))
 15.         gen `var'_norm = `var'/gmean
 16.         drop log_`var'
 17.     }
 18.     gen n_ln_y1 = -log(mu_return_norm)
 19.     gen y1      =  mu_return_norm
 20.     gen s1_star = sigma_reg_exp_norm * mu_return_norm
 21.     gen x1_star = avg_pop_norm       * mu_return_norm
 22.     gen x2_star = avg_wage_pc_norm   * mu_return_norm
 23.     gen x3_star = (1/div_emp_diff_s_norm) * mu_return_norm
 24.     gen x4_star = (1/div_fished_s_norm)   * mu_return_norm
 25.     foreach v in s1 x1 x2 x3 x4 {
 26.         gen ln_`v'_star = log(`v'_star)
 27.     }
 28.     foreach v in x1 x2 x3 x4 {
 29.         gen ln_`v'sq = 0.5*(ln_`v'_star^2)
 30.     }
 31.     gen ln_s1sq = 0.5*(ln_s1_star^2)
 32.     gen ln_x1x2 = ln_x1_star*ln_x2_star
 33.     gen ln_x1x3 = ln_x1_star*ln_x3_star
 34.     gen ln_x1x4 = ln_x1_star*ln_x4_star
 35.     gen ln_x2x3 = ln_x2_star*ln_x3_star
 36.     gen ln_x2x4 = ln_x2_star*ln_x4_star
 37.     gen ln_x3x4 = ln_x3_star*ln_x4_star
 38.     foreach v in x1 x2 x3 x4 {
 39.         gen ln_`v's1 = ln_`v'_star*ln_s1_star
 40.     }
 41. end

. 
. foreach mode in 179 179 {
  2. }

. 
. foreach mode in CURRENT NEW {
  2.     if "`mode'" == "CURRENT" local m 179
  3.     else local m 177
  4.     di ""
  5.     di "{hline 70}"
  6.     di "=== `mode'  (normalize over `m' rows) ==="
  7.     di "{hline 70}"
  8.     buildehdf `m'
  9.     local RHS ln_x1_star ln_x2_star ln_x3_star ln_x4_star ln_x1sq ln_x2sq 
> ln_x3sq ln_x4sq ln_x1x2 ln_x1x3 ln_x1x4 ln_x2x3 ln_x2x4 ln_x3x4 ln_s1_star ln
> _s1sq ln_x1s1 ln_x2s1 ln_x3s1 ln_x4s1
 10.     if "`m'" == "179" {
 11.         quietly sfcross n_ln_y1 `RHS', dist(h) cost ///
>             usigma(broader_permit_share_norm avg_fish_ratio_im_norm) ///
>             technique(nr) dif posthessian iter(500)
 12.     }
 13.     else {
 14.         quietly sfcross n_ln_y1 `RHS', dist(h) cost ///
>             usigma(broader_permit_share_norm avg_fish_ratio_im_norm) ///
>             technique(bhhh 20 nr 20) dif posthessian iter(6000)
 15.     }
 16.     di "   N = " e(N) "   LL = " %12.6f e(ll)
 17.     estimates store f_`mode'
 18. 
.     di ""
 19.     di "   --- mean of the log regressors in the estimation sample ---"
 20.     foreach v in ln_s1_star ln_x1_star ln_x2_star ln_x3_star ln_x4_star {
 21.         quietly summarize `v' if e(sample)
 22.         di "      mean(`v') = " %12.9f r(mean)
 23.     }
 24. 
.     di ""
 25.     di "   --- first-order coefficients ---"
 26.     foreach v in ln_s1_star ln_x1_star ln_x2_star ln_x3_star ln_x4_star {
 27.         di "      b[`v'] = " %12.9f _b[`v']
 28.     }
 29. 
.     local ES "(_b[ln_s1_star] + _b[ln_x3s1]*L3TOK + _b[ln_x4s1]*L4TOK)"
 30.     local E1 "(_b[ln_x1_star] + _b[ln_x1x3]*L3TOK + _b[ln_x1x4]*L4TOK)"
 31.     local E2 "(_b[ln_x2_star] + _b[ln_x2x3]*L3TOK + _b[ln_x2x4]*L4TOK)"
 32.     local E3 "(_b[ln_x3_star] + _b[ln_x3sq]*L3TOK + _b[ln_x3x4]*L4TOK)"
 33.     local E4 "(_b[ln_x4_star] + _b[ln_x4sq]*L4TOK + _b[ln_x3x4]*L3TOK)"
 34.     local MRT "-`ES' / (1 + `ES' + `E1' + `E2' + `E3' + `E4')"
 35. 
.     scalar L_ZERO = 0
 36.     local e : subinstr local MRT "L3TOK" "(L_ZERO)", all
 37.     local e : subinstr local e   "L4TOK" "(L_ZERO)", all
 38.     di ""
 39.     di "   --- Table S2: MRT at means ---"
 40.     nlcom (at_means: `e')
 41. 
.     quietly summarize div_emp_diff_s_norm if e(sample), detail
 42.     scalar L3_Q1 = ln(1/r(p25))
 43.     scalar L3_Q2 = ln(1/r(p50))
 44.     scalar L3_Q3 = ln(1/r(p75))
 45.     quietly summarize div_fished_s_norm if e(sample), detail
 46.     scalar L4_Q1 = ln(1/r(p25))
 47.     scalar L4_Q2 = ln(1/r(p50))
 48.     scalar L4_Q3 = ln(1/r(p75))
 49. 
.     di "   --- Table S5: varying x3 (fisheries at median) ---"
 50.     estimates restore f_`mode'
 51.     local SPEC ""
 52.     forvalues k = 1/3 {
 53.         local e : subinstr local MRT "L3TOK" "(L3_Q`k')", all
 54.         local e : subinstr local e   "L4TOK" "(L4_Q2)",   all
 55.         local SPEC `"`SPEC' (NMRT_x3_Q`k': `e')"'
 56.     }
 57.     nlcom `SPEC'
 58. 
.     di "   --- Table S5: varying x4 (sectoral at median) ---"
 59.     estimates restore f_`mode'
 60.     local SPEC ""
 61.     forvalues k = 1/3 {
 62.         local e : subinstr local MRT "L3TOK" "(L3_Q2)",   all
 63.         local e : subinstr local e   "L4TOK" "(L4_Q`k')", all
 64.         local SPEC `"`SPEC' (NMRT_x4_Q`k': `e')"'
 65.     }
 66.     nlcom `SPEC'
 67. }

